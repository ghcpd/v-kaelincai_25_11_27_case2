{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Event Log Schema",
  "type": "object",
  "properties": {
    "sessionId": {"type":"string", "pattern":"^sid_"},
    "timestamp": {"type":"string", "format":"date-time"},
    "eventType": {"type":"string"},
    "details": {"type":"object"}
  },
  "required": ["sessionId","timestamp","eventType"]
}
